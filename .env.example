# BrainStorm — переменные окружения
# Скопируйте этот файл в .env и заполните значения

# Секретные ключи
SECRET_KEY=brainstorm-super-secret-key-change-me-in-production
ADMIN_SECRET_KEY=change-me-admin-secret-key
CHEAT_TESTER_CODE=change-me-cheat-code

# AI-провайдеры (нужен хотя бы один; без них игра работает на встроенном банке вопросов)
# OpenRouter — провайдер по умолчанию (модель openai/gpt-4o-mini)
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (альтернатива)
OPENAI_API_KEY=

# Ollama — локальная модель, ключ не нужен
# OLLAMA_HOST=http://localhost:11434

# GigaChat API (Сбер)
# Получить ключ: https://developers.sber.ru/studio/
# ВАЖНО: GIGACHAT_CREDENTIALS должен быть в формате base64!
# Формат: base64(client_id:client_secret)
# Пример: echo -n "your_client_id:your_client_secret" | base64
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Настройки сервера
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=false

# База данных
# Локально (docker compose): postgres://brainstorm:brainstorm@localhost:5432/brainstorm
# Supabase: строка из Dashboard → Project Settings → Database (sslmode добавляется
# автоматически, кэш prepared statements для пулера :6543 отключается сам)
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase MCP (для агентов и локальной разработки, см. docs/database/supabase.md)
# Personal access token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
